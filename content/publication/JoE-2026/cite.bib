author = {Herschberger, Jacob E. and Calixto, Eduardo S. and Campbell, Valerie R. and Maron, John L. and Hahn, Philip G.},
title = {Variation of multiple plant defences and herbivory reveal different patterns of adaptation across a productivity gradient},
journal = {Journal of Ecology},
volume = {114},
number = {8},
pages = {e70423},
keywords = {biogeographic range, herbivory, latitudinal gradient, plant defences, plant–herbivore interactions, plant-insect interactions, productivity gradient},
